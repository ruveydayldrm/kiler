# --- Veritabanı ---
# Varsayılan: kurulumsuz SQLite (dosya prisma/dev.db içinde oluşur)
DATABASE_URL="file:./dev.db"
# PostgreSQL için (önce `npm run db:use-postgres`):
# DATABASE_URL="postgresql://kiler:kiler@localhost:5432/kiler?schema=public"

# --- Kimlik doğrulama (Auth.js v5) ---
# Üretmek için: npx auth secret   veya   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- OpenAI (opsiyonel) ---
# Boş bırakılırsa uygulama demo (kural tabanlı) modda çalışır.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
